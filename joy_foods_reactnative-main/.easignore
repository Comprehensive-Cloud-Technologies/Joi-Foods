# EAS upload ignore list (replaces .gitignore for cloud builds).
# NOTE: .env is intentionally NOT ignored here so react-native-dotenv
# can read BASE_URL / AUTH_TOKEN during the cloud build.

# node
node_modules/
npm-debug.log
yarn-error.log

# Android build artifacts
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/local.properties
.gradle/
.kotlin/

# iOS build artifacts
ios/build/
ios/Podfile.lock
ios/Pods/
DerivedData/
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# misc
.DS_Store
.idea/
*.iml
*.hprof
*.jsbundle
.metro-health-check*
/coverage

# secrets that should NOT go to the cloud (release keystore stays local)
joi-foods-release-key.jks
jks_info.txt
