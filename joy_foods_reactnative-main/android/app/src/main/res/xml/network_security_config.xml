<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTP traffic for your specific domain -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- <domain includeSubdomains="true">joy-stage.zbit.ltd</domain> -->
        <domain includeSubdomains="true">portal.joifood.co</domain>
        <domain includeSubdomains="true">zbit.ltd</domain>
    </domain-config>
    
    <!-- Allow HTTP for localhost/development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
        <domain includeSubdomains="true">::1</domain>
    </domain-config>
    
    <!-- Default configuration for all other domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config> 