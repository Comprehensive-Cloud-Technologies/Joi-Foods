{
  "name": "joy_foods",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "startRC": "react-native start --reset-cache",
    "adb": "devices=$(adb devices | grep -v List | grep -v '^$') && device_count=$(echo \"$devices\" | wc -l) && if [ \"$device_count\" -eq 1 ]; then device=$(echo \"$devices\" | cut -f1) && adb -s \"$device\" reverse tcp:8081 tcp:8081; else echo \"$devices\" | awk '{print NR \". \" $1}' && read -p 'Select device number: ' num && selected_device=$(echo \"$devices\" | sed -n \"${num}p\" | cut -f1) && adb -s \"$selected_device\" reverse tcp:8081 tcp:8081; fi"
  },
